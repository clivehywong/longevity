#!/bin/bash
#SBATCH --job-name={{ job_name }}
#SBATCH --array=1-{{ num_subjects }}%{{ max_concurrent }}
#SBATCH --partition={{ partition }}
#SBATCH --cpus-per-task={{ cpus }}
#SBATCH --mem={{ memory }}
#SBATCH --time={{ time_limit }}
#SBATCH --output=logs/sub-%a_%j.out
#SBATCH --error=logs/sub-%a_%j.err

# fMRIPrep SLURM submission script
# Generated by NeuConn HPC Workflow Manager
# Subjects: {{ subjects | join(', ') }}

# Initialize module system if available
if [ -f /etc/profile.d/modules.sh ]; then
    source /etc/profile.d/modules.sh
elif [ -f /usr/share/Modules/init/bash ]; then
    source /usr/share/Modules/init/bash
fi

# Load singularity module if available
if command -v module &> /dev/null; then
    module purge
    module load singularity 2>/dev/null || true
fi

# Configuration
BIDS_DIR="{{ remote_bids }}"
OUT_DIR="{{ remote_fmriprep }}"
IMG="{{ singularity_image }}"
LICENSE="{{ freesurfer_license }}"

# Get subject ID from array task
SUBID=$(sed -n "${SLURM_ARRAY_TASK_ID}p" "{{ remote_base }}/sublist.txt")

if [ -z "$SUBID" ]; then
    echo "ERROR: Could not get subject ID for array task ${SLURM_ARRAY_TASK_ID}"
    exit 1
fi

WORK_DIR="{{ remote_work }}/sub-${SUBID}"

echo "======================================"
echo "Processing subject: ${SUBID}"
echo "Array task: ${SLURM_ARRAY_TASK_ID}"
echo "Job ID: ${SLURM_JOB_ID}"
echo "Node: $(hostname)"
echo "Start time: $(date)"
echo "======================================"

# Create output directories
mkdir -p ${OUT_DIR} ${WORK_DIR} {{ remote_base }}/logs

# Run fMRIPrep
singularity run --cleanenv \
  --bind ${BIDS_DIR}:/data:ro \
  --bind ${OUT_DIR}:/out \
  --bind ${WORK_DIR}:/work \
  --bind ${LICENSE}:/opt/freesurfer/license.txt \
  ${IMG} \
  /data /out participant \
  --participant-label ${SUBID} \
  --fs-license-file /opt/freesurfer/license.txt \
  --nthreads ${SLURM_CPUS_PER_TASK} \
  --mem_mb {{ memory_mb }} \
  --work-dir /work \
  --output-spaces {{ output_spaces | join(' ') }} \
{%- for flag in fmriprep_flags %}
  {{ flag }} \
{%- endfor %}
  --resource-monitor

EXIT_CODE=$?

# fMRIPrep may exit non-zero due to --resource-monitor Nipype cleanup issues
# even after printing "finished successfully!".  Only override the exit code
# when the *final* outputs exist — confounds are generated mid-pipeline and
# their presence alone does NOT confirm the run completed.
#
# Required for a complete NIfTI run:
#   1. HTML report
#   2. At least one *desc-preproc_bold.nii.gz (MNI-space normalised BOLD)
#   3. MNI-space brain mask in anat/ (confirms anatomy normalisation finished)
REPORT_FILE="${OUT_DIR}/sub-${SUBID}.html"
BOLD_FOUND=$(find "${OUT_DIR}/sub-${SUBID}" -name "*desc-preproc_bold.nii.gz" -type f 2>/dev/null | head -1)
ANAT_MASK_FOUND=$(find "${OUT_DIR}/sub-${SUBID}/anat" -name "*space-MNI152NLin6Asym*desc-brain_mask.nii.gz" -type f 2>/dev/null | head -1)

if [ ${EXIT_CODE} -ne 0 ]; then
    if [ -f "${REPORT_FILE}" ] && [ -n "${BOLD_FOUND}" ] && [ -n "${ANAT_MASK_FOUND}" ]; then
        echo "WARNING: fMRIPrep exited with code ${EXIT_CODE} but all required outputs are present — treating as success"
        EXIT_CODE=0
    else
        echo "ERROR: fMRIPrep exited with code ${EXIT_CODE} and outputs are incomplete."
        [ ! -f "${REPORT_FILE}" ]     && echo "  Missing: HTML report (${REPORT_FILE})"
        [ -z "${BOLD_FOUND}" ]        && echo "  Missing: *desc-preproc_bold.nii.gz (MNI-space BOLD not written — MNI normalisation may have failed)"
        [ -z "${ANAT_MASK_FOUND}" ]   && echo "  Missing: MNI anat brain mask"
    fi
fi

echo "======================================"
echo "Finished subject: ${SUBID}"
echo "Exit code: ${EXIT_CODE}"
echo "End time: $(date)"
echo "======================================"

exit ${EXIT_CODE}
